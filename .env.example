# Copia este archivo a ".env" y rellena lo que necesites.
# El archivo .env está ignorado por git (no se sube al repositorio).

# --- News API (Etapa 1.2) ---
# Sin clave, las búsquedas usan datos simulados automáticamente.
VITE_NEWS_API_KEY=tu_clave_de_newsapi_org

# --- Back-end propio (Etapa 3) ---
# URL de tu API. Por defecto http://localhost:3001 en desarrollo.
VITE_MAIN_API_URL=http://localhost:3001

# Pon "true" para trabajar sin backend (auth y guardado simulados en localStorage).
VITE_USE_MOCK_MAIN=false
